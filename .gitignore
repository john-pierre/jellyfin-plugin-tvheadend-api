# Git does not support trailing comments on pattern lines: everything after the
# pattern (including the "#") becomes part of the pattern itself. Every rule below
# must therefore stay on its own line, with comments on separate lines.

# Build output
bin/
obj/
publish/
artifacts/

# User-specific project files
*.user
*.rsuser
*.suo
*.userosscache
*.sln.docstates

# Logs
*.log

# Editor / IDE
.vscode/
.vs/
.idea/
*.sln.iml

# Package management
*.nupkg
*.snupkg
packages/
project.lock.json
project.fragment.lock.json

# Temporary and backup files
*.tmp
*.bak
*.old
*.swp
*~

# Compiled binaries and debug symbols
*.exe
*.dll
*.pdb

# OS metadata
.DS_Store
Icon?
Thumbs.db
ehthumbs.db
desktop.ini

# Test output
TestResults/
coverage.cobertura.xml
*.trx

# Local SQLite databases produced by running the plugin or its tests
*.db
*.db-shm
*.db-wal

# Local configuration and secrets
appsettings.*.json

# Misc caches
*.cache
*.ide
/docker/.dev-volumes/
/docker/dev-version.txt

# Python bytecode from the docker helper scripts
__pycache__/
*.py[cod]

# Node / Playwright
node_modules/
tests/playwright/test-results/
tests/playwright/playwright-report/
tests/playwright/blob-report/

# AI Agent local artifacts
agent-results/
