<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Jellyfin.Plugin.TvHeadendApi</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Nullable>enable</Nullable>
    <AnalysisMode>AllEnabledByDefault</AnalysisMode>
    <CodeAnalysisRuleSet>./Jellyfin.ruleset</CodeAnalysisRuleSet>
    <!-- Version properties live in ../Directory.Build.props; CI overrides them via -p:. -->
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Jellyfin.Plugin.TvHeadendApi.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <!--
      ExcludeAssets=runtime matches the official jellyfin-plugin-template: the server already
      provides these assemblies, so they must never be copied into the plugin package where they
      would shadow the host's own copies.
      The upper bound is deliberate. An open-ended range ([10.10.7,)) silently resolves to
      whatever is newest, so a future Jellyfin major could change the compiled-against ABI
      without a single line of this repo changing.
    -->
    <PackageReference Include="Jellyfin.Controller" Version="[10.10.7,10.11.0)">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Model" Version="[10.10.7,10.11.0)">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.4" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SerilogAnalyzer" Version="0.15.0" PrivateAssets="All" />
    <PackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.556" PrivateAssets="All" />
    <PackageReference Include="SmartAnalyzers.MultithreadingAnalyzer" Version="1.1.31" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Configuration\ConfigPage.html" />
    <EmbeddedResource Include="Configuration\ConfigPage.html" />
    <None Remove="Page\DashboardPage.html" />
    <EmbeddedResource Include="Page\DashboardPage.html" />
    <!--
      Chart.js is vendored rather than loaded from a CDN: the dashboard's analytics section is
      admin-authenticated and must also work on air-gapped or egress-filtered servers, where the
      CDN fetch silently left the whole section blank. MIT licensed (see Page/lib/chart.js-LICENSE.md),
      which is compatible with this plugin's GPL-3.0.
    -->
    <None Remove="Page\lib\chart.umd.min.js" />
    <EmbeddedResource Include="Page\lib\chart.umd.min.js" />
  </ItemGroup>

</Project>
